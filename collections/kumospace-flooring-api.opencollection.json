          },
          "http": {
            "method": "POST",
            "url": "/v1/stockBackgrounds",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new stock background for a room.  (i.e., flooring).  Can only be\ncalled by kumospace admins."
        }
