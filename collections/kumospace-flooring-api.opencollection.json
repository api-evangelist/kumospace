            "params": [
              {
                "name": "next",
                "value": "",
                "type": "query",
                "description": "An opaque cursor used to request the next page of results.\nIt is provided in the previous response from the api."
              }
            ]
          },
          "docs": "Get a paginated list of stock room backgrounds.\n\nSubsequent pages can be requested with the \"next\" parameter, which is\nreturned in the response metadata object if another page exists."
        },
        {
          "info": {
